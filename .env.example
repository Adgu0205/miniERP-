# Copy to .env. All optional — app runs offline with sane defaults.
SECRET_KEY=dev-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=*

# Postgres (Supabase). Unset => SQLite.
# DATABASE_URL=postgres://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres

# Redis (Upstash). Unset => in-memory cache, synchronous procurement.
# REDIS_URL=redis://default:PASSWORD@host:6379
